# --- server ---
PORT=3000
CABINETS_DIR=./cabinets
CALL_LOG_DIR=./call-logs
# Secretary memos per patient (admin command NOTE), one JSON file per cabinet, read into the prompt.
PATIENT_NOTES_DIR=./patient-notes
RETENTION_DAYS=90

# --- Vapi webhook ---
# Set the same value in Vapi → Server URL → secret. Requests without it are rejected.
VAPI_SECRET=change-me
# Fallback cabinet when the called number is not in any cabinets/*.json
DEFAULT_CABINET_ID=demo

# --- model stack handed to Vapi in assistant-request ---
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
STT_PROVIDER=deepgram
STT_MODEL=nova-3
TTS_PROVIDER=azure
TTS_VOICE=ar-TN-HediNeural
# After the ElevenLabs clone: TTS_PROVIDER=11labs  TTS_VOICE=<voice id>

# --- Google Calendar (cabinets with "calendar": {"provider": "google", "calendar_id": "..."}) ---
# Service-account key: a file path or the JSON itself. Share each cabinet's calendar with the
# service-account email ("Make changes to events"). Only read once a cabinet is on google.
# GOOGLE_SERVICE_ACCOUNT_JSON=./google-sa.json

# --- Gemini (Amira on WhatsApp: patient texts and voice notes answered in the chat) ---
# Without a key patient messages are logged and left alone; admin commands and button taps still work.
# Voice notes also need WA_ACCESS_TOKEN below (the audio is downloaded from Meta).
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# --- WhatsApp Cloud API ---
# Webhook verification: any string, repeated in Meta → WhatsApp → Configuration → Verify token.
WA_VERIFY_TOKEN=change-me-too
# Meta app secret (App settings → Basic). When set, every POST must carry a valid X-Hub-Signature-256.
# WA_APP_SECRET=
# Sending: with both set the app binds MetaWhatsAppNotifier (confirmations, staff alerts, admin replies go
# out on WhatsApp); without them ConsoleNotifier only logs. Phone number ID and a permanent system-user
# token from Meta → WhatsApp → API Setup.
# WA_PHONE_NUMBER_ID=
# WA_ACCESS_TOKEN=
# Approved template for the booking confirmation outside Meta's 24 h window (a patient who only called):
# body "{{1}}" + two quick-reply buttons Confirmer / Annuler. Inside the window interactive buttons are used.
# WA_TEMPLATE_BOOKING=booking_confirm
# Approved template for staff messages outside the window (emergency alert to the doctor, patient message for the
# secretary): body "{{1}}". Admin replies answer a message just received, so they stay free-form text.
# WA_TEMPLATE_STAFF=staff_notice
# WA_TEMPLATE_LANG=ar
